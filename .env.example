# Copy to .env and fill in. Every variable here is read on the server only
# (lib/claude/client.ts) — never rename one to NEXT_PUBLIC_*, that would ship
# the key to the browser.

# Which provider the extraction routes call: "claude" or "openrouter".
# Unset falls back to "claude", unless OPENROUTER_API_KEY is set on its own.
AI_PROVIDER=openrouter

# --- claude -----------------------------------------------------------------
# Hosted endpoint that answers { "output": "..." } and takes the key as an
# X-API-Key header. Required when AI_PROVIDER=claude.
CLAUDE_API_KEY=
# Optional; defaults to https://a1vm.duckdns.org/api/claude when unset.
CLAUDE_API_URL=https://a1vm.duckdns.org/api/claude

# --- openrouter (https://openrouter.ai) --------------------------------------
# Both are required when AI_PROVIDER=openrouter. The model must accept images:
# question and figure extraction attach rendered page images.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta/muse-spark-1.3-contributor
